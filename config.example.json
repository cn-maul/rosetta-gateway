{
  "listen": "127.0.0.1:8666",
  "db_path": "./data/gateway.db",
  "log_level": "info",
  "master_key_env": "ROSETTA_GW_MASTER_KEY",
  "public_origin": "",
  "trusted_proxy_cidrs": [],
  "timezone": "Asia/Shanghai",
  "usage_retention_days": 30,
  "audit_log_keep_rows": 20000,
  "probes": {
    "enabled": true,
    "interval_sec": 600,
    "timeout_ms": 30000,
    "concurrency": 4,
    "down_threshold": 3,
    "window_size": 10,
    "healthy_rate": 0.8,
    "retention_days": 30
  },
  "defaults": {
    "upstream_timeout_ms": 300000,
    "stream_idle_timeout_ms": 120000,
    "stream_first_token_timeout_ms": 60000,
    "max_retries": 2,
    "max_request_body_bytes": 33554432,
    "failover_max_targets": 3,
    "failover_failure_threshold": 3
  },
  "bootstrap": {
    "providers": [
      {
        "slug": "deepseek",
        "name": "DeepSeek",
        "protocol": "auto",
        "endpoint": "https://api.deepseek.com/v1",
        "proxy_url": "",
        "credentials": [
          {
            "label": "main",
            "api_key_env": "DEEPSEEK_API_KEY"
          }
        ],
        "models": ["deepseek-chat", "deepseek-reasoner"]
      }
    ],
    "routes": [
      { "public_name": "gpt-4o", "provider": "deepseek", "model": "deepseek-chat" }
    ]
  }
}
