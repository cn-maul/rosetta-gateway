# 构建产物与本地运行时
#注意：所有目录型规则都必须以 / 开头锚定根目录。
#裸写的目录名会匹配**任意层级**的同名目录——`gateway/` 曾把
# `cmd/gateway/` 整个排除在版本控制之外，导致 billing.go 等7 个文件从未入库，
# CI 检出后编译报 `undefined: billingSubscription`。
/bin/
*.log

# Go 本地缓存（GOMODCACHE / GOCACHE，本轮开发产生的巨型目录）
/.gobuild/
/.gocache/

# 前端工程
/web/node_modules/
/web/dist/

# 工作区数据（配置、数据库、截图、备份等，含敏感凭据）
/.workbuddy/

# 根目录测试遗留二进制
/gateway.exe

# 管理后台密码（含盐哈希，不应入库）
/admin_auth.json

# 旧版运行目录（库 / 配置 / 主密钥，含敏感凭据，绝不入库）。
# 必须写成 `/gateway/`：不加前导斜杠会连带忽略 `cmd/gateway/`（源码目录）。
/gateway/

# 主密钥（44字符 base64url）。入库即等于把全部上游凭据的加密材料公开——
# 拿到它就能解出providers 里所有 api_key。运行时自动生成，每台机器各不相同。
/master.key

# 本地实际配置（含 admin_token / providers api_key / routes）。
# config.example.json 才是应该入库的那份。
/config.json

# SQLite 数据库目录（用户 / 用量 / 凭据 / 审计日志等真实运行数据）
/data/
*.db
*.db-shm
*.db-wal
